{"name":"Disciple of the Moon","type":"subclass","_id":"martyrsub001","img":"icons/magic/symbols/moon-crescent-red.webp","system":{"description":{"value":"<p>Disciples of the Moon see death as the ultimate judgment and suffering as the inevitable journey towards it. Your power grows as you inflict pain and witness the demise of others.</p>","chat":"","unidentified":""},"source":"Martyr Class","identifier":"disciple-moon","classIdentifier":"martyr","advancement":[{"_id":"moonadv001","type":"ItemGrant","title":"Bonus Proficiency","icon":"systems/dnd5e/icons/svg/proficiencies.svg","configuration":{"items":["Compendium.dnd5e.rules.kfaEFNYPRAd3LZXG"],"optional":false,"spell":null},"value":{},"level":3},{"_id":"moonadv002","type":"ItemGrant","title":"Hellbent","icon":"icons/magic/death/skull-horned-goat-pentagram-red.webp","configuration":{"items":["Compendium.dnd5e-martyr-class.martyr-class-features.moonhellbent"],"optional":false,"spell":null},"value":{},"level":3},{"_id":"moonadv003","type":"ItemGrant","title":"Bane of Sisyphus","icon":"icons/magic/death/skull-energy-light-teal.webp","configuration":{"items":["Compendium.dnd5e-martyr-class.martyr-class-features.moonbane"],"optional":false,"spell":null},"value":{},"level":6},{"_id":"moonadv004","type":"ItemGrant","title":"Impending Conviction","icon":"icons/magic/symbols/rune-sigil-black.webp","configuration":{"items":["Compendium.dnd5e-martyr-class.martyr-class-features.moonconviction"],"optional":false,"spell":null},"value":{},"level":11},{"_id":"moonadv005","type":"ItemGrant","title":"Burden of Existence","icon":"icons/magic/death/hand-undead-skeleton-fire.webp","configuration":{"items":["Compendium.dnd5e-martyr-class.martyr-class-features.moonburden"],"optional":false,"spell":null},"value":{},"level":15},{"_id":"moonadv006","type":"ItemGrant","title":"Aspect of Death","icon":"icons/magic/death/skull-energy-light-purple.webp","configuration":{"items":["Compendium.dnd5e-martyr-class.martyr-class-features.moonaspect"],