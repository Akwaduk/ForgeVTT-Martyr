    {
        "name":  "Vindicate",
        "type":  "spell",
        "img":  "icons/magic/light/beam-rays-orange-large.webp",
        "system":  {
                       "description":  {
                                           "value":  "\u003cp\u003eYou invoke final judgment upon foes who have truly harmed you. Choose any number of enemies within 60 ft that have dealt \u003cstrong\u003e50 HP or more\u003c/strong\u003e damage to you since your last long rest. Each must make a WIS save.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eFail:\u003c/strong\u003e a solar/lunar bolt erases the creature, dropping it to 0 HP with no death saves.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSuccess:\u003c/strong\u003e it instead takes \u003cstrong\u003e12d10 radiant or necrotic\u003c/strong\u003e (your choice).\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eRestriction:\u003c/strong\u003e Only usable if the sun or moon is visible to you.\u003c/p\u003e",
                                           "chat":  "",
