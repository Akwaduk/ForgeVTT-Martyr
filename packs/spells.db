[{"name":"Absolution","type":"spell","img":"icons/magic/lightning/bolt-strike-blue.webp","system":{"description":{"value":"<p>A sky-splitter bolt pierces your heart; you suffer <strong>6d10 lightning</strong> damage. Each enemy within 30 feet must make a Wisdom save.</p><p><strong>On a failure:</strong> takes force damage equal to <strong>Â½</strong> the lightning you took, is pushed 20 feet directly away, and knocked prone.</p><p><strong>On a success:</strong> takes force damage equal to <strong>Â¼</strong> the lightning; no push or prone.</p>","chat":"","unidentified":""},"source":"Martyr Class","activation":{"type":"action","cost":1,"condition":""},"duration":{"value":null,"units":"inst"},"target":{"value":30,"width":null,"units":"ft","type":"sphere"},"range":{"value":null,"long":null,"units":"self"},"uses":{"value":null,"max":"","per":null,"recovery":""},"consume":{"type":"attribute","target":"flags.dnd5e-martyr-class.vengeance","amount":30},"ability":"cha","actionType":"save","attackBonus":"","chatFlavor":"Lightning sacrifice for divine judgment","critical":{"threshold":null,"damage":""},"damage":{"parts":[["6d10","lightning"]],"versatile":""},"formula":"","save":{"ability":"wis","dc":null,"scaling":"spell"},"level":6,"school":"evo","components":{"value":"","vocal":true,"somatic":true,"material":false,"ritual":false,"concentration":false},"materials":{"value":"","consumed":false,"cost":0,"supply":0},"preparation":{"mode":"prepared","prepared":false},"scaling":{"mode":"none","formula":""}},"ownership":{"default":0,"PLAYER":2,"ASSISTANT":3},"flags":{},"_stats":{"systemId":"dnd5e","systemVersion":"3.3.1","coreVersion":"12.331","createdTime":1736445600000,"modifiedTime":1736445600000,"lastModifiedBy":"martyrmodule"},"folder":null,"sort":600000,"_id":"absolution"},{"name":"Altar of Sacrifice","type":"spell","img":"icons/environment/settlement/altar-stone-temple.webp","system":{"description":{"value":"<p>A gore-slick pillar (hit points = <strong>d6 Ã— Wis modifier</s