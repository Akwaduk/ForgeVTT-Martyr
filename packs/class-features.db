                                       "amount":  null
                                   },
                       "ability":  null,
                       "actionType":  "other",
                       "attackBonus":  "",
                       "chatFlavor":  "Sacrifice vitality for enhanced damage",
                       "critical":  {
                                        "threshold":  null,
                                        "damage":  ""
                                    },
                       "damage":  {
                                      "parts":  [
                                                    [
                                                        "@mod",
